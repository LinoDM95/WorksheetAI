VITE_API_BASE_URL=http://localhost:8000/api

# Muss zur gleichen öffentlichen App-URL passen wie FRONTEND_PUBLIC_URL im Backend,
# damit Passwort-Reset-Links aus E-Mails zur richtigen Seite führen.

# Für QR-/Links zur Schüler-Ansicht: öffentlicher Origin der App (z. B. http://192.168.1.42:5173),
# wenn der Scanner-Gerät nicht „localhost“ des Lehrerrechners erreicht. Sonst wird window.location.origin genutzt.
# VITE_PUBLIC_APP_URL=http://192.168.1.42:5173

# Optional: Axios-Timeouts in Millisekunden (Smartboard kann viele sequentielle KI-Aufrufe haben).
# VITE_API_TIMEOUT_MS=2700000
# VITE_API_LONG_BOARD_TIMEOUT_MS=3600000

# Lokales Testen: auf true setzen, um den Login-Schirm zu überspringen
VITE_DISABLE_LOGIN=false
