# ── Kopie nach .env und Werte anpassen. .env ist gitignored.
# ── Jede Variable hat einen Default in backend/config/settings.py — hier nur tunen, was abweicht.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3

# --- Produktion / Sicherheit (ohne Docker; Reverse-Proxy selbst konfigurieren) ---
# DJANGO_DEBUG=False
# DJANGO_USE_X_FORWARDED_PROTO=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# DJANGO_LOG_LEVEL=INFO
# SENTRY_DSN=
# REDIS_URL=redis://127.0.0.1:6379/1
# DISABLE_API_THROTTLE=False
# API_THROTTLE_ANON=200/hour
# API_THROTTLE_USER=5000/hour
# Gunicorn: Worker-Timeout >= längster Pipeline-Lauf (mehrere Gemini-Runden möglich; je Aufruf bis GEMINI_TIMEOUT_SECONDS).
# GUNICORN_GRACEFUL_TIMEOUT ebenfalls hoch genug: bei Deploy (SIGTERM) sonst Worker-Abbruch trotz hohem Timeout.
# Render Start aus backend/:  gunicorn --config gunicorn.conf.py config.wsgi:application
# Oder Migration + Gunicorn in einem:  sh start_render.sh
# GUNICORN_TIMEOUT=1800
# GUNICORN_GRACEFUL_TIMEOUT=1800
# WEB_CONCURRENCY / GUNICORN_WORKERS: sync-Workers (jeweils eine Request gleichzeitig).
# Ohne GUNICORN_ALLOW_SINGLE_WORKER wird die Zahl auf mindestens GUNICORN_MIN_SYNC_WORKERS (Standard 2)
# angehoben — auch wenn das Hosting WEB_CONCURRENCY=1 setzt (sonst blockiert eine lange KI alle APIs).
# GUNICORN_MIN_SYNC_WORKERS=2
# GUNICORN_ALLOW_SINGLE_WORKER=false
# WEB_CONCURRENCY=2
#
# Ein-Server: gebautes Frontend + API gleiche Origin
# SERVE_FRONTEND=False
# FRONTEND_DIST_DIR=../frontend/dist
# SERVE_MEDIA_WITH_DJANGO=False
# BOARDS_VISUAL_QA_ALLOWED=False
#
# Render.com + PostgreSQL: nach Verknüpfung mit leerer DB unbedingt Migrationen ausführen
# (sonst 500 bei Registrierung: relation "auth_user" does not exist).
# Im Dienst unter "Release Command":  sh release.sh  (Repo-Root) oder
#   cd backend && python manage.py migrate --noinput

# Access-JWT (Minuten). Längere Pipelines: Wert >= erwartete Browser-Sitzung oder z. B. 360+;
# das Frontend erneuert Cookies zusätzlich vor Board-NDJSON-Streams.
# JWT_ACCESS_TOKEN_LIFETIME_MINUTES=120

# True = API mit JWT-Cookies geschützt; False = nur lokale Tests ohne Login (niemals produktiv so lassen)
API_REQUIRE_AUTH=True

# Nutzer-Credits: geschätzte USD-Tokenkosten → EUR (AI_COST_USD_TO_EUR) → Credits (USER_CREDITS_PER_EUR=1000 ⇒ 10000 Credits ≙ 10 EUR).
# AI_CREDITS_ENABLED=False schaltet Sperre + Abbuchung aus (z. B. für lokale Tests ohne Auth).
# USER_CREDITS_REFERENCE_CAP = Max-Anzeige für die Credit-Blase im Frontend.
# AI_CREDITS_ENABLED=True
# USER_CREDITS_INITIAL_BALANCE=10000
# USER_CREDITS_REFERENCE_CAP=10000
# USER_CREDITS_PER_EUR=1000
# AI_COST_USD_TO_EUR=0.92

# --- HTTP / SPA (Vite) / Cookie-JWT ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Öffentliche URL der React-App (Link in Passwort-Reset-E-Mails). In Produktion z. B. https://app.example.com
FRONTEND_PUBLIC_URL=http://localhost:5173

# E-Mail (Passwort zurücksetzen / ggf. später weitere Transaktionsmails)
# Lokal: Ausgabe in der Konsole des runserver
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=WorksheetAI <noreply@localhost>
# Optional Schutz: max. Anfragen pro IP und Zeitfenster (Sekunden)
# PASSWORD_RESET_MAX_PER_IP_PER_HOUR=10
# PASSWORD_RESET_THROTTLE_WINDOW_SECONDS=3600
# Produktion z. B. SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# Produktion (HTTPS, Subdomains): ggf. JWT_AUTH_COOKIE_SECURE=True, SameSite=None, Domain setzen
# JWT_AUTH_COOKIE_SECURE=True
# JWT_AUTH_COOKIE_SAMESITE=None
# JWT_AUTH_COOKIE_DOMAIN=.example.com

# --- KI: gemeinsam ---
# gemini | mock | claude
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
# Wenn GEMINI_MODEL z. B. Preview ist und die API „model not found“ liefert → dieses Modell probieren (leer = aus).
GEMINI_MODEL_FALLBACK=gemini-2.5-pro
GEMINI_TEMPERATURE=0.35
GEMINI_TIMEOUT_SECONDS=600
GEMINI_MAX_OUTPUT_TOKENS=65536
# GEMINI_ENABLE_REVIEW_PASS=True

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_SEND_TEMPERATURE=false

# --- Boards / Smartboard (Defaults reichen meist; nur bei Bedarf) ---
# BOARDS_AI_PROVIDER=default
# BOARDS_VISUAL_QA_DOCUMENT_BASE=http://127.0.0.1:5173/
# BOARDS_VISUAL_QA_ALLOWED=True
# Nachprompt (Revision): Zeichen-Limit pro Block HTML/CSS/JS im Prompt (Standard 200000 — kleinere Werte schneiden lange Boards ab).
# AI_BOARD_FREE_HTML_REVISION_BLOCK_MAX_CHARS=200000

# SMARTBOARD_USE_PIPELINE=True
# SMARTBOARD_SMALL_MODEL=gemini-2.5-flash
# SMARTBOARD_LARGE_MODEL=gemini-2.5-pro

# ASSET_ENGINE_ENABLED=True
# Preview-/Teuer-Modell nur wenn nötig:
# GEMINI_MODEL=gemini-3.1-pro-preview
# GEMINI_MODEL_FALLBACK=gemini-2.5-pro
# SMARTBOARD_LARGE_MODEL=gemini-3.1-pro-preview

# --- Lehrplan (apps curricula) ---
# CURRICULUM_EXTRACTION_PROVIDER=
# CURRICULUM_AUTO_DISCOVERY_PROVIDER=

# --- Geschätzte API-Kosten (USD / 1 Mio. Tokens) für Usage-Logs + Credit-Abbuchung ---
# Defaults Pro/Preview/Gemini-3-Pfad (Prompt ≤200k Tokens): 2 $ Input / 12 $ Output pro 1M (Google Gemini 3 Pro, Stand Nutzerangabe).
# Prompt-Tokens > Schwelle → AI_GEMINI_LONG_CONTEXT_* (Default 4 $ / 18 $ pro 1M).
# AI_GEMINI_PROMPT_TOKEN_THRESHOLD_LONG_CONTEXT=200000
# AI_GEMINI_LONG_CONTEXT_INPUT_PRICE_PER_MILLION_USD=4
# AI_GEMINI_LONG_CONTEXT_OUTPUT_PRICE_PER_MILLION_USD=18
# Denk-Tokens (thoughts) zur Ausgabe-Rechnung addieren — entspricht „Ausgabe inkl. Denk-Tokens“ bei Google.
# Thinking/Reasoning (Gemini): Standard mitabrechnen (wie Output-Tarif). Ausschalten: AI_GEMINI_EXCLUDE_THINKING_FROM_BILLING=True
# oder Legacy AI_GEMINI_COUNT_THINKING_TOKENS_AS_OUTPUT=False.
# AI_GEMINI_EXCLUDE_THINKING_FROM_BILLING=False
# AI_GEMINI_COUNT_THINKING_TOKENS_AS_OUTPUT=True
# AI_FALLBACK_* entspricht dem Kurz-Prompt-Pro-Tarif (2 / 12), wenn eine Modell-Stufe fehlt.
# AI_GEMINI_FLASH_INPUT_PRICE_PER_MILLION_USD=
# AI_GEMINI_FLASH_OUTPUT_PRICE_PER_MILLION_USD=
# AI_CLAUDE_INPUT_PRICE_PER_MILLION_USD=
# AI_CLAUDE_OUTPUT_PRICE_PER_MILLION_USD=

# --- Vollliste ---
# Alle env()-Schlüssel: backend/config/settings.py durchsuchen.
