DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True

# Lokales Testen ohne JWT: auf False setzen (niemals in Produktion)
API_REQUIRE_AUTH=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=sqlite:///db.sqlite3

# AI: gemini (Standard). Optional: mock nur offline ohne API-Key; claude = gesamte App über Anthropic (Arbeitsblätter + optional Boards)
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Pro: gemini-2.5-pro | schneller: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-pro
GEMINI_TEMPERATURE=0.35
GEMINI_TIMEOUT_SECONDS=180

# Optional: Anthropic Claude (API-Key von console.anthropic.com). Ermöglicht AI_PROVIDER=claude und
# in der App den „Ultra“-Schalter für Tafelbilder (höhere Kosten als reines Gemini).
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_OUTPUT_TOKENS=32768
CLAUDE_TIMEOUT_SECONDS=600
CLAUDE_WORKSHEET_TEMPERATURE=0.35
# false = Standard für aktuelle Modelle (4.6/4.7 lehnen ``temperature`` ab). true = nur für ältere Claude-Modell-IDs.
CLAUDE_SEND_TEMPERATURE=false

# Page defaults
DEFAULT_PAGE_FORMAT=A4
DEFAULT_PAGE_ORIENTATION=portrait
DEFAULT_MARGIN_TOP_MM=12
DEFAULT_MARGIN_RIGHT_MM=12
DEFAULT_MARGIN_BOTTOM_MM=12
DEFAULT_MARGIN_LEFT_MM=12

# Boards (Interaktive Free-HTML5-Tafelbilder / Smartboard)
# 'default' nutzt AI_PROVIDER; 'mock' = offline; 'claude' = immer Anthropic für Boards.
# Mit CLAUDE_API_KEY: In der UI „Ultra (Claude)“ pro Generierung/Revision unabhängig von AI_PROVIDER.
BOARDS_AI_PROVIDER=default
BOARDS_FREE_HTML_GENERATION_TEMPERATURE=0.55
BOARDS_FREE_HTML_REVISION_TEMPERATURE=0.4
# Validierungs-Reparatur (wenn serverseitige Sandbox-Prüfung fehlschlägt)
BOARDS_FREE_HTML_REPAIR_TEMPERATURE=0.25
# Max. zusätzliche KI-Aufrufe zur Behebung von Validierungsfehlern (0 = nur eine Prüfung, keine Reparatur)
BOARDS_FREE_HTML_MAX_REPAIR_ATTEMPTS=2
# Visuelle Layoutprüfung (optional): pip install playwright && playwright install chromium
# Muss die erreichbare Vite-Basis sein (gleicher Host wie im Browser), z. B. http://127.0.0.1:5173/
BOARDS_VISUAL_QA_DOCUMENT_BASE=http://127.0.0.1:5173/
BOARDS_VISUAL_QA_ALLOWED=True

# Lehrplan-Import (apps.curricula) — keine Demo-Seeds für CurriculumContext
# Leer lassen = gleicher Provider wie AI_PROVIDER
CURRICULUM_EXTRACTION_PROVIDER=
CURRICULUM_REQUIRE_HUMAN_REVIEW=True
CURRICULUM_MAX_PAGES_PER_EXTRACTION=8
CURRICULUM_STORE_SOURCE_EXCERPTS=True
CURRICULUM_SHOW_USAGE_TO_TEACHERS=True
CURRICULUM_MAX_SOURCE_UPLOAD_MB=50
# Auto-Modus (RLP-PDF in einem Rutsch): Discovery + Map-Reduce-Extraktion
CURRICULUM_AUTO_DISCOVERY_PROVIDER=
CURRICULUM_AUTO_MAX_PAGES_PER_SLICE=12
CURRICULUM_AUTO_MAX_TOTAL_SLICES=80
# Obergrenze auch bei vielen TOC-Fächern (Discovery skaliert bis hier)
CURRICULUM_AUTO_MAX_TOTAL_SLICES_HARD_CAP=400
# TOC-Fächer nachziehen: zusätzliche KI-Runden bis jedes Fach abgedeckt ist
CURRICULUM_AUTO_DISCOVERY_MAX_ROUNDS=6
# PDF-Anfang für Inhaltsverzeichnis (Seiten 1..n)
CURRICULUM_AUTO_TOC_PAGES=14
CURRICULUM_AUTO_RETRY_LIMIT=2
CURRICULUM_AUTO_DISCOVERY_TEMPERATURE=0.0
